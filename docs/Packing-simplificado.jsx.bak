import React, { useEffect, useRef, useState } from 'react';
import { PackageCheck, CheckCircle2, Search, ArrowRight, AlertTriangle, X, ScanBarcode } from 'lucide-react';
import { Heading, ProductImage, Modal, Field } from '../components/Common';
import { api } from '../services/api';
import ProductLookup from './Scan';

export default function Packing({role,refreshInventory,toast}) {
  const [orders,setOrders]=useState([]),[selectedId,setSelectedId]=useState(null),[filter,setFilter]=useState('open'),[query,setQuery]=useState(''),[busy,setBusy]=useState(false),[error,setError]=useState(''),[photo,setPhoto]=useState(null),[newOrder,setNewOrder]=useState(false),[lookup,setLookup]=useState(false);
  const request=useRef(crypto.randomUUID());
  async function load(){const rows=await api('/orders');setOrders(rows);return rows;}
  useEffect(()=>{load().catch(e=>setError(e.message));const timer=setInterval(()=>load().catch(()=>{}),5000);return()=>clearInterval(timer);},[]);
  const selected=orders.find(o=>o.id===selectedId),pending=orders.filter(o=>['pending','packing'].includes(o.status));
  const visible=orders.filter(o=>(filter==='open'?['pending','packing'].includes(o.status):o.status==='packed')&&`${o.number} ${o.customer_name} ${o.platform}`.toLowerCase().includes(query.toLowerCase()));
  async function open(order){if(busy)return;setSelectedId(order.id);setError('');request.current=crypto.randomUUID();if(['pending','packing'].includes(order.status)&&!order.preparation_started_at&&!order.stock_issues?.length){setBusy(true);try{await api(`/orders/${order.id}/start`,{method:'POST',body:{request_id:crypto.randomUUID()}});await load();}catch(e){setError(e.message);await load().catch(()=>{});}finally{setBusy(false);}}}
  async function ready(){if(!selected||busy)return;setBusy(true);setError('');try{await api(`/orders/${selected.id}/complete`,{method:'POST',body:{request_id:request.current,items:selected.items.map(i=>({id:i.id,qty:i.qty}))}});await load();await refreshInventory();toast(`PED-${String(selected.number).padStart(5,'0')} listo para entregar`);}catch(e){setError(e.message);await load().catch(()=>{});}finally{setBusy(false);}}
  async function demo(shortage=false){setBusy(true);try{const result=await api('/orders/demo',{method:'POST',body:{request_id:crypto.randomUUID(),scenario:shortage?'shortage':'normal'}});const rows=await load();await refreshInventory();setFilter('open');await open(rows.find(o=>o.id===result.id));}catch(e){setError(e.message);}finally{setBusy(false);}}
  async function cancel(){if(!confirm('¿Cancelar este pedido? Se liberará su reserva, si existe.'))return;setBusy(true);try{await api(`/orders/${selected.id}/cancel`,{method:'POST',body:{request_id:crypto.randomUUID()}});await load();await refreshInventory();setSelectedId(null);toast('Pedido cancelado');}catch(e){setError(e.message);}finally{setBusy(false);}}
  const blocked=!!selected?.stock_issues?.length,done=selected?.status==='packed',active=selected&&['pending','packing'].includes(selected.status);
  return <><Heading eyebrow="BODEGA" title="Empaque" subtitle="Revisa los productos y deja el pedido listo."><div className="simpleHeadActions"><button className="outline" onClick={()=>setLookup(true)}><ScanBarcode size={16}/>Buscar código</button>{role==='admin'&&<details className="demoOptions"><summary>Opciones demo</summary><div><button disabled={busy} onClick={()=>demo()}>Nuevo ejemplo Manu</button><button disabled={busy} onClick={()=>demo(true)}>Ejemplo sin stock</button><button onClick={()=>setNewOrder(true)}>Crear pedido local</button></div></details>}</div></Heading><div className="simplePacking"><aside className="simpleQueue"><div className="simpleQueueTabs"><button className={filter==='open'?'active':''} onClick={()=>setFilter('open')}>Pendientes <span>{pending.length}</span></button><button className={filter==='packed'?'active':''} onClick={()=>setFilter('packed')}>Listos</button></div><div className="simpleSearch"><Search size={17}/><input aria-label="Buscar pedido" placeholder="Buscar pedido o cliente" value={query} onChange={e=>setQuery(e.target.value)}/></div>{visible.map(o=><button disabled={busy} key={o.id} className={'simpleOrder '+(o.id===selectedId?'selected':'')} onClick={()=>open(o)}><div><b>PED-{String(o.number).padStart(5,'0')}</b><span className={o.stock_issues?.length?'simpleMissing':'simpleSource'}>{o.stock_issues?.length?'Falta stock':o.platform}</span></div><strong>{o.customer_name}</strong><small>{o.items.length} productos · {o.items.reduce((n,i)=>n+i.qty,0)} unidades <ArrowRight size={15}/></small></button>)}{!visible.length&&<p className="empty">{filter==='open'?'Todo al día. No hay pedidos pendientes.':'Todavía no hay pedidos listos.'}</p>}</aside><div className="simpleDetail">{selected?<><div className="simpleDetailHeader"><div><span className="eyebrow">{selected.platform}{selected.platform==='Manu'?' · DEMO LOCAL':''}</span><h2>PED-{String(selected.number).padStart(5,'0')}</h2><p>{selected.customer_name}</p></div><span className={'simpleState '+(blocked?'blocked':done?'done':'')}>{blocked?'Falta stock':done?'Listo para entregar':'Por preparar'}</span></div>{blocked&&<div className="simpleStockAlert" role="alert"><AlertTriangle size={21}/><div><b>No se puede preparar este pedido</b>{selected.stock_issues.map(i=><p key={i.variant_id}>{selected.items.find(l=>l.variant_id===i.variant_id)?.product.name}: {i.missing?`${i.missing===1?'falta':'faltan'} ${i.missing} ${i.missing===1?'unidad':'unidades'}`:i.reason}.</p>)}</div></div>}<div className="simpleProductList">{selected.items.map(i=><div className="simplePackingProduct" key={i.id}><button className="simplePhoto" aria-label={`Ampliar foto de ${i.product.name}`} onClick={()=>setPhoto(i.product)}><ProductImage product={i.product} large/></button><div><h3>{i.product.name}</h3><small>{i.product.sku}</small></div><strong>× {i.qty}</strong></div>)}</div>{error&&<p className="formError" role="alert">{error}</p>}<div className="simpleReadyFooter">{done?<div className="simpleDone"><CheckCircle2 size={24}/><b>Pedido preparado · Listo para entregar</b></div>:active?<><p>Confirma cuando todos los productos estén empacados.</p><button className="primary simpleReadyButton" disabled={busy||blocked} onClick={ready}><PackageCheck size={20}/>{busy?'Guardando…':'Pedido preparado'}</button></>:<p>Pedido cancelado</p>}</div>{role==='admin'&&active&&selected.stock_policy==='reserved'&&<details className="secondaryOrderOptions"><summary>Más opciones</summary><button className="link" disabled={busy} onClick={cancel}>Cancelar pedido</button></details>}</>:<div className="simplePackingEmpty"><PackageCheck size={48}/><h2>Vamos a preparar pedidos</h2><p>Selecciona uno de la lista para ver sus productos.</p></div>}</div></div>{!selected&&error&&<p className="formError" role="alert">{error}</p>}{photo&&<Modal title={photo.name} onClose={()=>setPhoto(null)}><div className="simpleLargePhoto"><ProductImage product={photo} large/></div><div className="formActions"><button className="primary" onClick={()=>setPhoto(null)}>Volver al pedido</button></div></Modal>}{lookup&&<Modal title="Buscar producto por código" onClose={()=>setLookup(false)}><ProductLookup/></Modal>}{newOrder&&<OrderForm close={()=>setNewOrder(false)} saved={async id=>{const rows=await load();await refreshInventory();setFilter('open');await open(rows.find(o=>o.id===id));}}/>}</>;
}

function OrderForm({close,saved}) {
  const [products,setProducts]=useState([]),[lines,setLines]=useState([]),[customer,setCustomer]=useState(''),[reference,setReference]=useState(''),[platform,setPlatform]=useState('Manu'),[error,setError]=useState(''),[busy,setBusy]=useState(false),[requestId]=useState(()=>crypto.randomUUID());
  useEffect(()=>{api('/catalog').then(setProducts).catch(e=>setError(e.message));},[]);
  async function submit(e){e.preventDefault();setBusy(true);try{const result=await api('/orders',{method:'POST',body:{platform,external_reference:reference,customer_name:customer,items:lines,request_id:requestId}});await saved(result.id);close();}catch(e){setError(e.message);}finally{setBusy(false);}}
  return <Modal title="Nuevo pedido local" onClose={close}><p>Registro manual para demostrar el flujo. Si hay stock para todas las líneas, se reserva completo. Si falta algún producto, el pedido queda bloqueado hasta reponerlo.</p><form onSubmit={submit}><div className="formGrid"><Field label="Cliente" required value={customer} onChange={e=>setCustomer(e.target.value)}/><Field label="Referencia de pedido" required value={reference} onChange={e=>setReference(e.target.value)}/><label className="field">Origen<select value={platform} onChange={e=>setPlatform(e.target.value)}>{['Manu','Manual','Dropi','Dropea','Evolut','Jumpseller'].map(p=><option key={p}>{p}</option>)}</select></label><label className="field">Agregar producto<select value="" onChange={e=>{const id=e.target.value;if(id&&!lines.some(i=>i.id===id))setLines([...lines,{id,qty:1}]);}}><option value="">Selecciona un producto</option>{products.filter(p=>p.active).map(p=><option key={p.id} value={p.id}>{p.name} · {p.sku}</option>)}</select></label></div>{lines.map(line=><div className="item" key={line.id}><div className="grow"><b>{products.find(p=>p.id===line.id)?.name}</b></div><input aria-label={'Unidades '+line.id} className="qtyInput" type="number" min="1" required value={line.qty} onChange={e=>setLines(lines.map(i=>i.id===line.id?{...i,qty:Number(e.target.value)}:i))}/><button type="button" className="iconButton" aria-label="Quitar línea" onClick={()=>setLines(lines.filter(i=>i.id!==line.id))}>×</button></div>)}{error&&<p className="formError" role="alert">{error}</p>}<div className="formActions"><button className="primary" disabled={busy||!lines.length}>{busy?'Creando…':'Guardar pedido y revisar stock'}</button></div></form></Modal>;
}









